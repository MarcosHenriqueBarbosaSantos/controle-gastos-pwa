{
  "id": "./",
  "name": "Meus Gastos",
  "short_name": "Meus Gastos",
  "description": "Lance seus gastos no dia a dia e veja quanto o mês vai custar.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "prefer_related_applications": false,
  "background_color": "#f3f5f8",
  "theme_color": "#0b2545",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "site/img/tela-inicio.png",
      "sizes": "585x1266",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "O início: quanto está livre para gastar no mês"
    },
    {
      "src": "site/img/tela-vencimentos.png",
      "sizes": "585x1266",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Próximos vencimentos, com o Já paguei"
    },
    {
      "src": "site/img/tela-lancar.png",
      "sizes": "585x1266",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Lançar um gasto em segundos"
    },
    {
      "src": "site/img/tela-lista.png",
      "sizes": "585x1266",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "O extrato do mês, dia por dia"
    },
    {
      "src": "site/img/tela-computador.png",
      "sizes": "1600x825",
      "type": "image/png",
      "form_factor": "wide",
      "label": "O Meus Gastos no computador"
    }
  ],
  "shortcuts": [
    {
      "name": "Lançar gasto",
      "short_name": "Lançar",
      "description": "Abre o app já no formulário de lançar",
      "url": "./?atalho=lancar",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Lançar por voz",
      "short_name": "Por voz",
      "description": "Abre o app ouvindo: diga o gasto, como “gastei 32 no mercado no débito”",
      "url": "./?atalho=voz",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Ler QR code",
      "short_name": "QR code",
      "description": "Abre a câmera para ler o Pix ou o cupom",
      "url": "./?atalho=qr",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "url": "link",
      "files": [
        {
          "name": "arquivo",
          "accept": [
            "image/*",
            "application/pdf",
            ".pdf"
          ]
        }
      ]
    }
  },
  "categories": [
    "finance",
    "productivity"
  ]
}
